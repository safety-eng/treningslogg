---
import { Picture } from 'astro:assets';
import bilde from '../assets/hero-nidelva.png';
import { hero } from '../data/profil.mjs';
---
<section class="hero" aria-labelledby="hero-tittel">
  <div class="scene">
    <Picture
      src={bilde}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1774]}
      sizes="100vw"
      alt={hero.bildeAlt}
      loading="eager"
      fetchpriority="high"
      class="bilde"
    />
  </div>
  <div class="tekst">
    <h1 id="hero-tittel">{hero.tittel}</h1>
    <p>{hero.tekst}</p>
  </div>
</section>

<script>
  // Reserve for nettlesere uten CSS scroll-animasjoner (f.eks. eldre Firefox).
  const stottet = CSS.supports('animation-timeline: scroll()');
  const rolig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const img = document.querySelector<HTMLImageElement>('.hero .bilde');
  const tekst = document.querySelector<HTMLElement>('.hero .tekst');
  if (!stottet && !rolig && img && tekst) {
    let venter = false;
    const oppdater = () => {
      venter = false;
      const p = Math.min(1, window.scrollY / (window.innerHeight * 0.9));
      img.style.transform = `translateY(${30 * p}%) scale(${1 + 0.06 * p})`;
      if (getComputedStyle(tekst).position === 'absolute') {
        tekst.style.transform = `translateY(${-40 * p}%)`;
        tekst.style.opacity = String(1 - 0.8 * p);
      }
    };
    window.addEventListener('scroll', () => { if (!venter) { venter = true; requestAnimationFrame(oppdater); } }, { passive: true });
    oppdater();
  }
</script>

<style>
  .hero { position: relative; }

  .scene {
    position: relative;
    height: clamp(340px, 62svh, 560px);
    overflow: hidden;
    background: #d9d6d1;
  }
  .scene :global(.bilde) {
    position: absolute;
    left: 0;
    top: -6%;
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: 30% 40%;
    transform-origin: 50% 40%;
    will-change: transform;
  }
  /* Bildet glir over i sidebakgrunnen nederst. */
  .scene::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 35%;
    background: linear-gradient(to bottom, transparent, var(--paper));
    pointer-events: none;
  }

  .tekst {
    position: relative;
    max-width: var(--wrap);
    margin: -2.5rem auto 0;
    padding: 0 1.25rem 0.5rem;
  }
  h1 {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: clamp(3rem, 12vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0 0 1rem;
  }
  .tekst p { max-width: 44ch; font-size: 1.2rem; line-height: 1.5; color: var(--ink-2); margin: 0; }

  @media (prefers-color-scheme: dark) {
    .scene :global(.bilde) { filter: brightness(0.92); }
  }

  /* Store skjermer: tittelen står i den lyse himmelen mellom løperen og domkirken. */
  @media (min-width: 1000px) {
    .scene { height: clamp(520px, 82svh, 880px); }
    .scene :global(.bilde) { object-position: 35% 40%; }
    .tekst {
      position: absolute;
      top: 5%;
      left: 40%;
      right: 3%;
      margin: 0;
      padding: 0;
      max-width: none;
      color: #17212b;
    }
    h1 { font-size: clamp(4rem, 6.2vw, 7.5rem); white-space: nowrap; margin-bottom: 1.25rem; }
    .tekst p { max-width: 21rem; color: #2c3640; font-size: 1.18rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      /* Langformer med vilje: minifiseringen gjør ellers om til en ugyldig shorthand. */
      .scene :global(.bilde) {
        animation-name: hero-bilde;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 90vh;
      }
      @media (min-width: 1000px) {
        .tekst {
          animation-name: hero-tekst;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: scroll(root block);
          animation-range: 0 70vh;
        }
      }
    }
  }
  @keyframes hero-bilde {
    from { transform: translateY(0) scale(1); }
    to { transform: translateY(30%) scale(1.06); }
  }
  @keyframes hero-tekst {
    from { transform: translateY(0); opacity: 1; }
    to { transform: translateY(-40%); opacity: 0.2; }
  }
</style>
