---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MalSeksjon from '../components/MalSeksjon.astro';
import Dashboard from '../components/Dashboard.astro';
import InnleggListe from '../components/InnleggListe.astro';
import { hentOkter, hentInnlegg } from '../lib/data';
import { mal } from '../data/profil.mjs';

const okter = await hentOkter();
const innlegg = await hentInnlegg();
const planUke = innlegg.find((i) => i.data.plan?.navn === mal.planNavn)?.data.plan?.uke ?? null;
---
<Base>
  <Hero />
  <MalSeksjon okter={okter} planUke={planUke} />
  <div class="wrap"><hr class="lane" /></div>
  <Dashboard okter={okter} />
  <div class="wrap siste">
    <hr class="lane" />
    <h2>Siste innlegg</h2>
    <InnleggListe innlegg={innlegg.slice(0, 6)} />
    {innlegg.length > 6 && <p><a href="/okter/">Se alle {innlegg.length} innlegg</a></p>}
  </div>
</Base>

<style>
  .siste { margin-top: 3.5rem; }
  .siste h2 { margin: 2.5rem 0 1rem; }
</style>
