---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MalSeksjon from '../components/MalSeksjon.astro';
import Dashboard from '../components/Dashboard.astro';
import InnleggListe from '../components/InnleggListe.astro';
import NyhetsbrevSeksjon from '../components/NyhetsbrevSeksjon.astro';
import { hentOkter, hentInnlegg } from '../lib/data';

const okter = await hentOkter();
const innlegg = await hentInnlegg();
const planUke = innlegg.find((i) => i.data.plan)?.data.plan?.uke ?? null;
const ANTALL = 3;
---
<Base bilde="/og/forside.jpg">
  <Hero />
  <NyhetsbrevSeksjon />

  <!-- Statistikk: nåværende mål og dashbordet -->
  <MalSeksjon okter={okter} planUke={planUke} />
  <div class="wrap"><hr class="lane" /></div>
  <Dashboard okter={okter} />

  <section class="wrap siste" aria-labelledby="siste-tittel">
    <hr class="lane" />
    <div class="hode">
      <h2 id="siste-tittel">Siste innlegg</h2>
      <a href="/okter/">Alle økter ({innlegg.length})</a>
    </div>
    <InnleggListe innlegg={innlegg.slice(0, ANTALL)} minBredde="19rem" />
  </section>
</Base>

<style>
  .siste { margin-top: 3.5rem; padding-bottom: 1rem; }
  .hode { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin: 2.5rem 0 1.25rem; }
  .hode a { color: var(--ink-2); font-weight: 500; white-space: nowrap; padding: 0.6rem 0; }
</style>
